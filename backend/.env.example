# API runtime and Prisma CLI configuration. Copy to backend/.env for local development.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Supabase Auth verification; only the publishable key is needed, never service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
BETTER_AUTH_DEV_ENABLED=false
BETTER_AUTH_SCHEMA_READY=false
BETTER_AUTH_TOTP_SCHEMA_READY=false
CRM_SCHEMA_READY=false
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Runtime: use Supabase Session Pooler (port 5432) for IPv4-only local networks.
DATABASE_URL=postgresql://safeguard:safeguard_local_only@localhost:5432/safeguard?schema=public
# Optional Prisma CLI/migration URL. Prefer direct; otherwise use Session Pooler (5432).
# Never set this to Supabase Transaction Pooler (port 6543).
# DIRECT_URL=
