generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["safeguard"]
}

enum InternalRole {
  SUPER_ADMIN
  ADMIN
  SALES
  OPERATIONS
  VIEWER

  @@schema("safeguard")
}

enum InquiryStatus {
  NEW
  REVIEWING
  CONTACTED
  CLOSED

  @@schema("safeguard")
}

enum InquirySource {
  WEBSITE
  MANUAL

  @@schema("safeguard")
}

enum InquiryLocale {
  EN
  ES

  @@schema("safeguard")
}

enum OpportunityStage {
  NEW
  QUALIFIED
  QUOTATION
  NEGOTIATION
  WON
  LOST

  @@schema("safeguard")
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  TASK

  @@schema("safeguard")
}

enum ActivityTaskStatus {
  OPEN
  COMPLETED
  CANCELED

  @@schema("safeguard")
}

model InternalUser {
  id                 String        @id @default(uuid()) @db.Uuid
  authUserId         String?       @unique @map("auth_user_id") @db.Uuid
  betterAuthUserId   String?       @unique @map("better_auth_user_id") @db.Uuid
  email              String        @db.VarChar(320)
  fullName           String?       @map("full_name") @db.VarChar(200)
  role               InternalRole  @default(VIEWER)
  isActive           Boolean       @default(true) @map("is_active")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  betterAuthUser     User?         @relation(fields: [betterAuthUserId], references: [id], onDelete: SetNull)
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  authoredActivities Activity[]    @relation("ActivityAuthor")
  createdInquiries   Inquiry[]     @relation("InquiryCreator")

  @@map("internal_users")
  @@schema("safeguard")
}

model Company {
  id            String        @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name          String        @db.VarChar(200)
  legalName     String?       @map("legal_name") @db.VarChar(240)
  websiteUrl    String?       @map("website_url") @db.VarChar(2048)
  countryCode   String?       @map("country_code") @db.Char(2)
  city          String?       @db.VarChar(120)
  industry      String?       @db.VarChar(160)
  notes         String?       @db.Text
  archivedAt    DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  contacts      Contact[]
  inquiries     Inquiry[]
  opportunities Opportunity[]
  activities    Activity[]

  // Partial unique constraints for active normalized values are maintained in the candidate SQL migration.
  @@index([name])
  @@index([countryCode])
  @@index([archivedAt, createdAt])
  @@map("crm_companies")
  @@schema("safeguard")
}

model Contact {
  id            String        @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  firstName     String        @map("first_name") @db.VarChar(120)
  lastName      String?       @map("last_name") @db.VarChar(120)
  email         String?       @db.VarChar(320)
  phone         String?       @db.VarChar(64)
  jobTitle      String?       @map("job_title") @db.VarChar(160)
  notes         String?       @db.Text
  archivedAt    DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inquiries     Inquiry[]
  opportunities Opportunity[]

  @@index([companyId, archivedAt, lastName, firstName])
  @@index([email])
  @@map("crm_contacts")
  @@schema("safeguard")
}

model Inquiry {
  id               String         @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  source           InquirySource  @default(MANUAL)
  status           InquiryStatus  @default(NEW)
  locale           InquiryLocale?
  companyName      String?        @map("company_name") @db.VarChar(200)
  contactName      String?        @map("contact_name") @db.VarChar(240)
  email            String?        @db.VarChar(320)
  countryCode      String?        @map("country_code") @db.Char(2)
  phone            String?        @db.VarChar(64)
  productName      String?        @map("product_name") @db.VarChar(200)
  productReference String?        @map("product_reference") @db.VarChar(160)
  quantity         Decimal?       @db.Decimal(12, 3)
  message          String         @db.Text
  companyId        String?        @map("company_id") @db.Uuid
  contactId        String?        @map("contact_id") @db.Uuid
  opportunityId    String?        @map("opportunity_id") @db.Uuid
  createdById      String?        @map("created_by_id") @db.Uuid
  closedAt         DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company          Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact          Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity      Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdBy        InternalUser?  @relation("InquiryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activities       Activity[]

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([email, createdAt])
  @@index([companyId, createdAt])
  @@index([contactId])
  @@index([opportunityId])
  @@map("crm_inquiries")
  @@schema("safeguard")
}

model Opportunity {
  id              String           @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  contactId       String?          @map("contact_id") @db.Uuid
  ownerId         String?          @map("owner_id") @db.Uuid
  name            String           @db.VarChar(200)
  stage           OpportunityStage @default(NEW)
  estimatedAmount Decimal?         @map("estimated_amount") @db.Decimal(14, 2)
  currencyCode    String?          @map("currency_code") @db.Char(3)
  followUpAt      DateTime?        @map("follow_up_at") @db.Timestamptz(6)
  notes           String?          @db.Text
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contact         Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner           InternalUser?    @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  inquiries       Inquiry[]
  activities      Activity[]

  @@index([stage, createdAt])
  @@index([companyId, archivedAt, createdAt])
  @@index([ownerId, followUpAt])
  @@map("crm_opportunities")
  @@schema("safeguard")
}

model Activity {
  id            String              @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  type          ActivityType
  description   String              @db.VarChar(4000)
  occurredAt    DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(6)
  taskDueAt     DateTime?           @map("task_due_at") @db.Timestamptz(6)
  taskStatus    ActivityTaskStatus? @map("task_status")
  companyId     String?             @map("company_id") @db.Uuid
  opportunityId String?             @map("opportunity_id") @db.Uuid
  inquiryId     String?             @map("inquiry_id") @db.Uuid
  authorId      String              @map("author_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company       Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunity   Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  inquiry       Inquiry?            @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  author        InternalUser        @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([companyId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([inquiryId, occurredAt])
  @@index([authorId, occurredAt])
  @@index([type, taskStatus, taskDueAt])
  @@map("crm_activities")
  @@schema("safeguard")
}

model User {
  id            String        @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)
  role          String?
  banned        Boolean?      @default(false)
  banReason     String?
  banExpires    DateTime?     @db.Timestamptz(6)
  sessions      Session[]
  accounts      Account[]
  twoFactorEnabled Boolean? @default(false)
  twoFactorEnabledAt DateTime? @map("two_factor_enabled_at") @db.Timestamptz(6)
  twoFactors    TwoFactor[]
  internalUser  InternalUser?

  @@unique([email])
  @@map("user")
  @@schema("safeguard")
}

model TwoFactor {
  id                      String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String   @db.Uuid
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean? @default(true)
  failedVerificationCount Int?     @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
  @@schema("safeguard")
}

model Session {
  id             String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt      DateTime @db.Timestamptz(6)
  token          String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
  @@schema("safeguard")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@map("account")
  @@schema("safeguard")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
  @@schema("safeguard")
}

model RateLimit {
  id          String @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
  @@schema("safeguard")
}
