# Copy to frontend/.env.local; keep secrets private (NEXT_PUBLIC_* only are public).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
API_URL=http://localhost:4000/api/v1
# Server-only BFF destination. Never set database credentials or auth secrets here.
AUTH_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_DEV_ENABLED=false
BETTER_AUTH_SCHEMA_READY=false
BETTER_AUTH_TOTP_SCHEMA_READY=false
CRM_SCHEMA_READY=false
